DATABASE_URL="file:./dev.db"

SESSION_SECRET=""

# Comma-separated host:port entries this app is reached through — defaults
# to "localhost:3000" if unset. Needed for anything beyond local dev (see
# next.config.ts).
ALLOWED_ORIGINS="localhost:3000"

INTEGRITY_AUTH_URL="https://ae-api.integrity.com/ae-partner-auth-service/auth/token"
INTEGRITY_API_BASE_URL="https://ae-api.integrity.com/ae-partner-gateway-service"
INTEGRITY_CLIENT_ID=""
INTEGRITY_CLIENT_SECRET=""
INTEGRITY_AGENT_NPN=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

CALENDLY_API_TOKEN=""

# Website leads: the chrisfrascainsurance.com forms save a minimal record to a
# dedicated Airtable base; "Sync website leads" on /contacts pulls them in and
# then deletes them from Airtable. Use a token scoped to ONLY that base.
WEBSITE_LEADS_AIRTABLE_TOKEN=""
WEBSITE_LEADS_BASE_ID=""
WEBSITE_LEADS_TABLE="Leads"
