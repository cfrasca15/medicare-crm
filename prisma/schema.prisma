// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  ENGAGED        // talking with them, not enrolled (Integrity's "Engaged")
  APPOINTMENT_SET
  APPLICATION_SUBMITTED
  ENROLLED       // new client enrolled this season
  RETAINED       // existing client kept for the coming year
  CURRENT_CLIENT // existing client, not yet reviewed this season
  LOST
}

enum TaskStatus {
  OPEN
  DONE
}

model Contact {
  id                String        @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  // Second number. cellPreferred makes it the one the Call button dials.
  cellPhone         String?
  cellPreferred     Boolean       @default(false)
  address           String?
  city              String?
  state             String?
  zip               String?
  county            String?       // from Integrity, or worked out from the ZIP
  // Medi-Cal (Medicaid) and Extra Help (LIS): both allow plan changes outside AEP.
  medicaid          Boolean       @default(false)
  extraHelp         Boolean       @default(false)
  // A separate mailing address, used when hasMailingAddress is on.
  hasMailingAddress Boolean       @default(false)
  mailingAddress    String?
  mailingCity       String?
  mailingState      String?
  mailingZip        String?
  dateOfBirth       DateTime?
  medicareId        String?
  partAEffectiveDate DateTime?
  partBEffectiveDate DateTime?
  stage             PipelineStage @default(NEW_LEAD)

  // No longer shown on the contact page (it got mistaken for the client's
  // current plan); values entered there were copied into Policy. Still filled
  // by the CSV import and included in the CSV export.
  insuranceCompany  String?
  planName          String?

  // Prospect's doctor/medical group — tracked here so it can be verified
  // against a plan's network BEFORE enrollment, not just recorded after
  // (Policy has its own doctor/medicalGroup for the plan actually sold).
  doctor            String?
  medicalGroup      String?

  // Integrity linkage
  integrityContactId String?      @unique // Integrity's leadId
  integrityLeadStage Int?         // raw numeric stage code from Integrity; meaning not yet documented

  // Website tracking: leadSource is set once, when the website created this
  // contact (e.g. "Website: call-back request"); lastWebsiteLeadAt is bumped
  // every time the website sends another lead for them (new or returning).
  leadSource        String?
  lastWebsiteLeadAt DateTime?

  // Someone who speaks for the client (a son or daughter, a spouse, a
  // caregiver). altContactPreferred means "call this person, not the client".
  altContactName         String?
  altContactRelationship String?
  altContactPhone        String?
  altContactEmail        String?
  altContactPreferred    Boolean @default(false)

  // The contact's husband or wife, stored on both records (kept in step by
  // src/lib/actions/spouse.ts). A plain id rather than a relation.
  spouseId          String?
  // The contact who referred this one (a plain id, like spouseId).
  referredById      String?

  policies          Policy[]
  tasks             Task[]
  providers         ContactProvider[]
  pharmacies        ContactPharmacy[]
  prescriptions     ContactPrescription[]
  noteEntries       ContactNote[]
  activities        Activity[]
  serviceRequests   ServiceRequest[]
  aepReviews        AepReview[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([stage])
  @@index([spouseId])
  @@index([referredById])
  @@index([lastName, firstName])
}

// Providers/pharmacies/prescriptions are tracked locally because Integrity's
// partner API only supports POSTing new ones to a lead (confirmed via a live
// 405 on the read side) — there's no way to fetch back what's already saved,
// so the CRM has to keep its own copy to show/edit this data at all.
model ContactProvider {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  npi         String?
  name        String
  specialty   String?
  address1    String?
  city        String?
  state       String?
  zip         String?
  phone       String?

  syncedToIntegrity Boolean @default(false)

  createdAt   DateTime @default(now())

  @@index([contactId])
}

model ContactPharmacy {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  name        String
  address1    String?
  city        String?
  state       String?
  zip         String?
  phone       String?
  isMailOrder Boolean  @default(false)

  syncedToIntegrity Boolean @default(false)

  createdAt   DateTime @default(now())

  @@index([contactId])
}

model ContactPrescription {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  drugName     String
  chemicalName String?
  dosage       String?  // free-text — Integrity's dosage catalog isn't exposed via the API
  quantity     String?

  createdAt   DateTime @default(now())

  @@index([contactId])
}

// Timeline entries that aren't notes, tasks or plans: logged calls
// (type "call", outcome e.g. "no_answer") and stage changes (type "stage").
model Activity {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  type      String
  outcome   String?
  summary   String
  // Set on updates to a service request (type "service").
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceRequestId String?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@index([serviceRequestId])
  @@index([type, createdAt])
}

// Integrity leads "Sync from Integrity" skips (e.g. a duplicate that was
// merged into another contact), so they aren't imported again.
model IgnoredIntegrityLead {
  integrityContactId String   @id
  reason             String?
  createdAt          DateTime @default(now())
}

model ContactNote {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  body        String

  createdAt   DateTime @default(now())

  @@index([contactId])
}

// One record per CSV import "Apply" click — a permanent log of what a
// bulk upload actually changed, since a spreadsheet touching many
// contacts at once is exactly the kind of action worth being able to
// look back on later ("when did this get updated, and from what?").
model ImportBatch {
  id           String   @id @default(cuid())
  rowCount     Int      // rows selected for apply
  updatedCount Int      // contacts actually updated
  detailsJson  String   // JSON: per-contact { contactId, contactName, changes, pushResults }

  createdAt    DateTime @default(now())
}

model Policy {
  id                  String    @id @default(cuid())
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId           String

  carrier             String
  planName            String
  planType             String?  // MA, MAPD, PDP, Med Supp, etc.
  policyNumber        String?
  effectiveDate       DateTime?
  termDate            DateTime?
  // "current" = the plan they have now (no effective date needed);
  // "future" = a plan starting later. Null on older rows: decided by date.
  timing              String?
  // "new" = a new client, "current" = an existing client.
  clientType          String?
  // The day the application was submitted (a calendar date, like
  // effectiveDate). Defaults to the day the plan is added; editable.
  submittedAt         DateTime?

  commissionStatus    String?   // e.g. pending, paid, chargeback
  commissionAmount    Float?    // expected
  commissionReceived  Float?    // actually paid by the carrier
  commissionPaidAt    DateTime?
  annualPremium       Float?

  doctor              String?
  medicalGroup        String?

  // 30/60/90-day client check-in emails — day 0 is this policy's own
  // effectiveDate, so a contact with multiple policies gets one sequence
  // per policy. Null means "not sent yet"; set once, never re-sent.
  milestone30SentAt   DateTime?
  milestone60SentAt   DateTime?
  milestone90SentAt   DateTime?

  // Integrity linkage
  integrityPolicyId   String?   @unique

  // Lines from imported carrier commission statements paid on this plan.
  payments            CommissionPayment[]
  serviceRequests     ServiceRequest[]

  createdAt           DateTime  @default(now())
  updatedAt            DateTime @updatedAt

  @@index([contactId])
}

// Fixed three rows (id "day30"/"day60"/"day90") edited in place — not a
// general list, so no create/delete UI, just editing the subject/body of
// each milestone's email.
model MilestoneEmailTemplate {
  id      String @id
  subject String
  body    String
}

model IntegrityStageMapping {
  code          Int            @id
  label         String
  pipelineStage PipelineStage?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id            String     @id @default(cuid())
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId     String?

  title         String
  notes         String?
  dueDate       DateTime?
  status        TaskStatus @default(OPEN)

  googleEventId    String?
  calendlyEventUri String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, dueDate])
  @@index([contactId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GoogleAccount {
  id           String   @id @default("default")
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A carrier commission statement uploaded on the Commissions page. Each line
// applied to a plan adds its amount to that plan's commissionReceived;
// undoing the statement takes them back off.
model CommissionStatement {
  id         String              @id @default(cuid())
  carrier    String
  fileName   String
  total      Float
  lineCount  Int
  createdAt  DateTime            @default(now())
  payments   CommissionPayment[]
}

model CommissionPayment {
  id          String              @id @default(cuid())
  statement   CommissionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementId String
  policy      Policy?             @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyId    String?
  memberName  String
  memberId    String?
  amount      Float
  paidOn      DateTime?
  description String?
  // Same line from the same carrier: used to skip it if the file is uploaded again.
  lineKey     String              @unique
  createdAt   DateTime            @default(now())

  @@index([statementId])
  @@index([policyId])
}

// Which column is which in a carrier's statement layout, remembered by its
// header row so the next statement in the same layout is set up already.
model CommissionLayout {
  signature String   @id
  carrier   String
  mapping   String   // JSON: field -> column index
  updatedAt DateTime @updatedAt
}

// A client issue being worked on (ID card not received, billing problem,
// doctor not in network...), open until resolved. Its updates are Activity
// rows, so they also show on the contact's timeline.
model ServiceRequest {
  id         String     @id @default(cuid())
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String
  // The plan it's about, if any.
  policy     Policy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyId   String?
  category   String     // see SERVICE_CATEGORIES
  title      String
  status     String     @default("open") // open, waiting, resolved
  waitingOn  String?    // with status "waiting": carrier, client, doctor...
  followUpOn DateTime?  // a calendar date, like Policy.effectiveDate
  resolvedAt DateTime?
  updates    Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([contactId])
  @@index([status])
}

// Where each client stands in one year's Annual Enrollment Period review
// (the AEP worklist). Clients without a row show a status worked out from
// their calls, bookings and plans (see src/lib/aep.ts).
model AepReview {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  year      Int      // the year AEP runs (Oct 15 – Dec 7), not the plan year
  status    String   // see AEP_STATUSES
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, year])
  @@index([year])
}
