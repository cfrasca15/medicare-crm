// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  APPOINTMENT_SET
  SOA_SIGNED
  APPLICATION_SUBMITTED
  ENROLLED
  RENEWAL
  LOST
}

enum TaskStatus {
  OPEN
  DONE
}

model Contact {
  id                String        @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  dateOfBirth       DateTime?
  medicareId        String?
  partAEffectiveDate DateTime?
  partBEffectiveDate DateTime?
  stage             PipelineStage @default(NEW_LEAD)
  notes             String?

  // Prospect's doctor/medical group — tracked here so it can be verified
  // against a plan's network BEFORE enrollment, not just recorded after
  // (Policy has its own doctor/medicalGroup for the plan actually sold).
  doctor            String?
  medicalGroup      String?

  // Integrity linkage
  integrityContactId String?      @unique // Integrity's leadId
  integrityLeadStage Int?         // raw numeric stage code from Integrity; meaning not yet documented

  policies          Policy[]
  tasks             Task[]
  providers         ContactProvider[]
  pharmacies        ContactPharmacy[]
  prescriptions     ContactPrescription[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([stage])
  @@index([lastName, firstName])
}

// Providers/pharmacies/prescriptions are tracked locally because Integrity's
// partner API only supports POSTing new ones to a lead (confirmed via a live
// 405 on the read side) — there's no way to fetch back what's already saved,
// so the CRM has to keep its own copy to show/edit this data at all.
model ContactProvider {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  npi         String?
  name        String
  specialty   String?
  address1    String?
  city        String?
  state       String?
  zip         String?
  phone       String?

  syncedToIntegrity Boolean @default(false)

  createdAt   DateTime @default(now())

  @@index([contactId])
}

model ContactPharmacy {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  name        String
  address1    String?
  city        String?
  state       String?
  zip         String?
  phone       String?
  isMailOrder Boolean  @default(false)

  syncedToIntegrity Boolean @default(false)

  createdAt   DateTime @default(now())

  @@index([contactId])
}

model ContactPrescription {
  id          String   @id @default(cuid())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String

  drugName     String
  chemicalName String?
  dosage       String?  // free-text — Integrity's dosage catalog isn't exposed via the API
  quantity     String?

  createdAt   DateTime @default(now())

  @@index([contactId])
}

model Policy {
  id                  String    @id @default(cuid())
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId           String

  carrier             String
  planName            String
  planType             String?  // MA, MAPD, PDP, Med Supp, etc.
  policyNumber        String?
  effectiveDate       DateTime?
  termDate            DateTime?

  commissionStatus    String?   // e.g. pending, paid, chargeback
  commissionAmount    Float?
  annualPremium       Float?

  doctor              String?
  medicalGroup        String?

  // Integrity linkage
  integrityPolicyId   String?   @unique

  createdAt           DateTime  @default(now())
  updatedAt            DateTime @updatedAt

  @@index([contactId])
}

model IntegrityStageMapping {
  code          Int            @id
  label         String
  pipelineStage PipelineStage?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id            String     @id @default(cuid())
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId     String?

  title         String
  notes         String?
  dueDate       DateTime?
  status        TaskStatus @default(OPEN)

  googleEventId    String?
  calendlyEventUri String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, dueDate])
  @@index([contactId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GoogleAccount {
  id           String   @id @default("default")
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
