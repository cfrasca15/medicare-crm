# Copy this to `docker.env` on the server and fill in real values
# (same values as .env.local, with two differences noted below).

# Points inside the container's persisted volume — don't change this.
DATABASE_URL="file:/app/data/prod.db"

SESSION_SECRET=""

# Comma-separated host:port entries this app is reached through — every
# hostname/IP you'll actually type into a browser to reach this server
# (e.g. "your-server.tailXXXXX.ts.net:3000,192.168.1.50:3000"). Missing one
# here means every button that saves data will silently do nothing when
# accessed via that address — no error, just a dead click (this is CSRF
# protection built into Next.js Server Actions; see next.config.ts).
ALLOWED_ORIGINS=""

# Leave unset (or "false") until this is served over real HTTPS (e.g. via
# a reverse proxy). Set to "true" once it is — until then, "true" would
# make browsers silently refuse to store the login cookie over plain HTTP.
COOKIE_SECURE="false"

INTEGRITY_AUTH_URL="https://ae-api.integrity.com/ae-partner-auth-service/auth/token"
INTEGRITY_API_BASE_URL="https://ae-api.integrity.com/ae-partner-gateway-service"
INTEGRITY_CLIENT_ID=""
INTEGRITY_CLIENT_SECRET=""
INTEGRITY_AGENT_NPN=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the server's real reachable address (e.g. your Tailscale
# hostname), not localhost — and must also be added as an authorized
# redirect URI in Google Cloud Console for this to work.
GOOGLE_REDIRECT_URI="https://your-server-address/api/google/callback"

CALENDLY_API_TOKEN=""
